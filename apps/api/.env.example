# API service
PORT=3001
NODE_ENV=development

# Postgres (docker-compose.yml в корне)
DATABASE_URL=postgresql://app:app@localhost:5432/app

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Файлы встреч
# Каталог для бинарников загруженных файлов (относительно cwd apps/api или абсолютный путь)
UPLOADS_DIR=./uploads
# Лимит размера одного файла в байтах (превышение → 413). 26214400 = 25 МиБ
MAX_UPLOAD_SIZE_BYTES=26214400
# Лимит размера аватара пользователя в байтах (PUT /users/me/avatar, превышение → 413). 5242880 = 5 МиБ
AVATAR_MAX_UPLOAD_SIZE_BYTES=5242880

# STT / Whisper (локальная транскрибация записей встреч)
# Движок распознавания речи: stub (детерминированная заглушка) | whisper (whisper.cpp как подпроцесс).
# На Фазе 1 дефолт — stub (безопасно без установленного whisper.cpp).
STT_ENGINE=stub
# Путь к бинарнику whisper.cpp (whisper-cli). Обязателен при STT_ENGINE=whisper.
WHISPER_BIN_PATH=
# Путь к ggml-модели whisper (рекомендуется tiny). Обязателен при STT_ENGINE=whisper.
# Каталог .whisper/ в git не попадает (см. корневой .gitignore). Разовая загрузка модели tiny:
#   mkdir -p .whisper && curl -L -o .whisper/ggml-tiny.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.bin
WHISPER_MODEL_PATH=./.whisper/ggml-tiny.bin
# Язык транскрибации: пусто → авто-детект; ru → принудительно русский.
WHISPER_LANGUAGE=
