# API service
PORT=3001
NODE_ENV=development

# Postgres (docker-compose.yml в корне)
DATABASE_URL=postgresql://app:app@localhost:5432/app

# CORS: origin(s) фронтенда, которым разрешён доступ к API (список через запятую).
WEB_ORIGIN=http://localhost:3000

# JWT. Секрет — минимум 32 символа, не плейсхолдер. В production невалидный секрет
# останавливает старт (см. src/config/env.validation.ts); ниже — значение только для локалки.
JWT_SECRET=local-dev-only-change-me-0123456789abcdef
JWT_EXPIRES_IN=1d

# Рейт-лимит (скользящее окно на IP). Дефолты в коде; 0 в LIMIT — выключить бакет.
# RATE_LIMIT_AUTH_LIMIT=10
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_PASSWORD_LIMIT=5
# RATE_LIMIT_PASSWORD_WINDOW_MS=60000

# Файлы встреч
# Каталог для бинарников загруженных файлов (относительно cwd apps/api или абсолютный путь)
UPLOADS_DIR=./uploads
# Лимит размера одного файла в байтах (превышение → 413). 26214400 = 25 МиБ
MAX_UPLOAD_SIZE_BYTES=26214400
# Лимит размера аватара пользователя в байтах (PUT /users/me/avatar, превышение → 413). 5242880 = 5 МиБ
AVATAR_MAX_UPLOAD_SIZE_BYTES=5242880
