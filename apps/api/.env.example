# API service
PORT=3001
NODE_ENV=development

# Postgres (docker-compose.yml в корне)
DATABASE_URL=postgresql://app:app@localhost:5432/app

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Файлы встреч
# Каталог для бинарников загруженных файлов (относительно cwd apps/api или абсолютный путь)
UPLOADS_DIR=./uploads
# Лимит размера одного файла в байтах (превышение → 413). 26214400 = 25 МиБ
MAX_UPLOAD_SIZE_BYTES=26214400
# Лимит размера аватара пользователя в байтах (PUT /users/me/avatar, превышение → 413). 5242880 = 5 МиБ
AVATAR_MAX_UPLOAD_SIZE_BYTES=5242880

# STT / Whisper (локальная транскрибация записей встреч)
# Движок распознавания речи: whisper (whisper.cpp как подпроцесс, дефолт) | stub (детерминированная заглушка).
# При STT_ENGINE=whisper нужны установленные whisper.cpp + ffmpeg и скачанная модель (см. apps/api/src/meeting-file/CLAUDE.md).
# validateEnv на старте: whisper без бинарника/модели → throw в production, warn вне его.
# Для локальной разработки без движка выставьте STT_ENGINE=stub.
STT_ENGINE=whisper
# Путь к бинарнику whisper.cpp (whisper-cli), любой абсолютный путь. Обязателен при STT_ENGINE=whisper.
WHISPER_BIN_PATH=
# Путь к ggml-модели whisper (рекомендуется tiny). Обязателен при STT_ENGINE=whisper.
# Каталог .whisper/ в git не попадает (см. корневой .gitignore). Разовая загрузка модели tiny:
#   pnpm --filter api whisper:model
WHISPER_MODEL_PATH=./.whisper/ggml-tiny.bin
# Язык транскрибации: пусто → авто-детект (-l auto); код языка (напр. ru) → принудительно этот язык.
WHISPER_LANGUAGE=
# Таймаут одной транскрибации, мс: по превышении подпроцесс убивается, файл → failed
# (очередь не залипает). Пусто / 0 / не число → дефолт в коде (300000 = 5 мин).
WHISPER_TIMEOUT_MS=300000
# Каталог для временных файлов транскрибации (сконвертированный не-WAV → WAV).
# Пусто → системный os.tmpdir(). Каталог задачи всегда удаляется после обработки.
WHISPER_TMP_DIR=

# Summary / суммаризация транскриптов встреч
# Движок суммаризации: claude (реальный вызов ClaudeAgentService через русский промпт, дефолт) | stub (детерминированная заглушка).
# При SUMMARY_ENGINE=claude требуется аутентификация (ambient Claude Code или ANTHROPIC_API_KEY).
# ClaudeSummaryService: системный промпт на русском, строгий JSON { summary: string, decisions: string[], actionItems: string[] }.
# Любой сбой API / невалидный ответ → summaryStatus=failed без частичных данных.
SUMMARY_ENGINE=claude

# Claude Agent SDK (модуль src/claude-agent)
# Пакет @anthropic-ai/claude-agent-sdk НЕ в зависимостях и грузится лениво — пока он не
# установлен (`pnpm --filter api add @anthropic-ai/claude-agent-sdk`), ClaudeAgentService
# бросает ClaudeAgentError, а эти переменные не имеют эффекта.
# Ключ Anthropic API. Необязателен: если пусто — ClaudeAgentService использует
# ambient-логин Claude Code (OAuth-креды `claude` в ~/.claude, напр. подписка Pro/Max).
# Задан → передаётся подпроцессу SDK явно (биллинг по API).
ANTHROPIC_API_KEY=
# Модель для одноразовых запросов ClaudeAgentService. Пусто → claude-haiku-4-5.
CLAUDE_AGENT_MODEL=
