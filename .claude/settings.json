{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Formatting with Prettier...",
            "command": "node -e 'let d=\"\";process.stdin.on(\"data\",c=>d+=c).on(\"end\",()=>{try{const j=JSON.parse(d);const f=(j.tool_input&&j.tool_input.file_path)||(j.tool_response&&j.tool_response.filePath);if(!f)return;require(\"child_process\").spawnSync(\"pnpm\",[\"exec\",\"prettier\",\"--write\",\"--ignore-unknown\",\"--log-level\",\"warn\",f],{stdio:\"ignore\"})}catch(e){}})' 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
